# Base de datos (usado por docker-compose y por Django)
POSTGRES_DB=datapulse
POSTGRES_USER=datapulse
POSTGRES_PASSWORD=datapulse
POSTGRES_HOST=db
POSTGRES_PORT=5433

# Django
DJANGO_SECRET_KEY=cambiar-esta-clave-en-produccion
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:4200

# JWT
JWT_ACCESS_LIFETIME_MIN=60
JWT_REFRESH_LIFETIME_DAYS=7

# APIs externas
WORLDBANK_API_BASE_URL=https://api.worldbank.org/v2
EXCHANGERATE_API_BASE_URL=https://api.exchangerate-api.com/v4
